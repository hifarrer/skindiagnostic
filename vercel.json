{
  "buildCommand": "cd mobile && npm install && chmod +x build-web.sh && ./build-web.sh",
  "outputDirectory": "mobile/web-build",
  "installCommand": "cd mobile && npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
