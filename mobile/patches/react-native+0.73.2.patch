@@ -0,0 +1,139 @@
+/**
+ * Web stub for RCTNetworking
+ * Uses browser's fetch API on web
+ */
+
+'use strict';
+
+const RCTDeviceEventEmitter = require('../EventEmitter/RCTDeviceEventEmitter');
+
+let requestIdCounter = 0;
+
+const RCTNetworking = {
+  addListener(eventType, listener, context) {
+    return RCTDeviceEventEmitter.addListener(eventType, listener, context);
+  },
+
+  sendRequest(
+    method,
+    trackingName,
+    url,
+    headers,
+    data,
+    responseType,
+    incrementalUpdates,
+    timeout,
+    callback,
+    withCredentials,
+  ) {
+    const requestId = ++requestIdCounter;
+    callback(requestId);
+
+    // Use fetch API for web
+    const fetchOptions = {
+      method,
+      headers: {
+        ...headers,
+      },
+      credentials: withCredentials ? 'include' : 'same-origin',
+    };
+
+    if (data && method !== 'GET' && method !== 'HEAD') {
+      fetchOptions.body = data;
+    }
+
+    // Set timeout if specified
+    let timeoutId = null;
+    if (timeout > 0) {
+      timeoutId = setTimeout(() => {
+        RCTDeviceEventEmitter.emit('didCompleteNetworkResponse', [
+          requestId,
+          'Request timeout',
+          true, // timeOutError
+        ]);
+      }, timeout);
+    }
+
+    fetch(url, fetchOptions)
+      .then(response => {
+        if (timeoutId) {
+          clearTimeout(timeoutId);
+        }
+
+        // Emit response event
+        const responseHeaders = {};
+        response.headers.forEach((value, key) => {
+          responseHeaders[key] = value;
+        });
+
+        RCTDeviceEventEmitter.emit('didReceiveNetworkResponse', [
+          requestId,
+          response.status,
+          responseHeaders,
+          response.url,
+        ]);
+
+        // Handle response based on type
+        if (responseType === 'text') {
+          return response.text();
+        } else if (responseType === 'blob') {
+          return response.blob();
+        } else {
+          return response.text();
+        }
+      })
+      .then(data => {
+        if (typeof data === 'string') {
+          if (incrementalUpdates) {
+            // For incremental updates, emit data in chunks
+            const chunkSize = 8192;
+            for (let i = 0; i < data.length; i += chunkSize) {
+              const chunk = data.slice(i, i + chunkSize);
+              RCTDeviceEventEmitter.emit('didReceiveNetworkIncrementalData', [
+                requestId,
+                chunk,
+                i,
+                data.length,
+              ]);
+            }
+          } else {
+            RCTDeviceEventEmitter.emit('didReceiveNetworkData', [requestId, data]);
+          }
+        } else {
+          // For blob, convert to text
+          data.text().then(text => {
+            RCTDeviceEventEmitter.emit('didReceiveNetworkData', [requestId, text]);
+          });
+        }
+
+        // Emit completion
+        RCTDeviceEventEmitter.emit('didCompleteNetworkResponse', [
+          requestId,
+          null,
+          false, // timeOutError
+        ]);
+      })
+      .catch(error => {
+        if (timeoutId) {
+          clearTimeout(timeoutId);
+        }
+        RCTDeviceEventEmitter.emit('didCompleteNetworkResponse', [
+          requestId,
+          error.message || 'Network request failed',
+          false, // timeOutError
+        ]);
+      });
+  },
+
+  abortRequest(requestId) {
+    // On web, we can't easily abort fetch requests after they've started
+    // This is a no-op for now
+  },
+
+  clearCookies(callback) {
+    // On web, cookies are managed by the browser
+    callback(false);
+  },
+};
+
+module.exports = RCTNetworking;
