+/**
+ * Captures the browser's native WebSocket before React Native overrides it
+ * This module should be required as early as possible
+ */
+
+'use strict';
+
+// Capture the native WebSocket immediately when this module is first loaded
+// This needs to happen before React Native's WebSocket class is defined
+let NativeBrowserWebSocket = null;
+
+if (typeof window !== 'undefined' && window.WebSocket) {
+  // Check if this is the real native WebSocket (has prototype.send as a native function)
+  const ws = window.WebSocket;
+  if (ws.prototype && typeof ws.prototype.send === 'function') {
+    // Check if it's React Native's WebSocket by looking for specific properties
+    if (!ws.prototype._registerEvents) {
+      NativeBrowserWebSocket = ws;
+    }
+  }
+}
+
+// Fallback checks
+if (!NativeBrowserWebSocket) {
+  if (typeof self !== 'undefined' && self.WebSocket) {
+    NativeBrowserWebSocket = self.WebSocket;
+  } else if (typeof globalThis !== 'undefined' && globalThis.WebSocket) {
+    NativeBrowserWebSocket = globalThis.WebSocket;
+  }
+}
+
+module.exports = NativeBrowserWebSocket;
