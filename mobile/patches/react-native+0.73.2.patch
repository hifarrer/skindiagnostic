new file mode 100644
index 0000000..87c46e9
--- /dev/null
+++ b/node_modules/react-native/Libraries/Alert/RCTAlertManager.web.js
@@ -0,0 +1,51 @@
+/**
+ * Web stub for RCTAlertManager
+ * Uses browser's native alert/dialog on web
+ */
+
+class RCTAlertManager {
+  static alertWithArgs(args: Object, callback: ?Function): void {
+    const {title, message, buttons} = args;
+    
+    // Build the alert message
+    let alertMessage = '';
+    if (title) {
+      alertMessage += title;
+    }
+    if (message) {
+      if (alertMessage) {
+        alertMessage += '\n\n';
+      }
+      alertMessage += message;
+    }
+    
+    // For web, use browser's native alert
+    // If there are buttons, we'll just show the first one's action
+    if (buttons && buttons.length > 0) {
+      // Get the first button's text
+      const firstButton = buttons[0];
+      const buttonText = Object.values(firstButton)[0] || 'OK';
+      
+      // Use confirm for multiple buttons, alert for single
+      if (buttons.length > 1) {
+        const result = window.confirm(alertMessage);
+        if (callback && result) {
+          // Call callback with first button index (0)
+          callback(0, null);
+        }
+      } else {
+        window.alert(alertMessage);
+        if (callback) {
+          callback(0, null);
+        }
+      }
+    } else {
+      window.alert(alertMessage);
+      if (callback) {
+        callback(0, null);
+      }
+    }
+  }
+}
+
+module.exports = RCTAlertManager;
