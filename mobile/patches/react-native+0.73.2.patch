+/**
+ * Web stub for BackHandler
+ * On web, back button is handled by browser history
+ */
+
+'use strict';
+
+const DeviceEventEmitter = require('../EventEmitter/RCTDeviceEventEmitter');
+
+function emptyFunction() {}
+
+const BackHandler = {
+  exitApp: emptyFunction,
+  
+  addEventListener(eventName, handler) {
+    if (eventName === 'hardwareBackPress' && typeof window !== 'undefined') {
+      // On web, listen to browser back button
+      const handlePopState = () => {
+        const result = handler();
+        // If handler returns true, prevent default back navigation
+        if (result === true) {
+          window.history.pushState(null, '', window.location.href);
+        }
+      };
+      
+      window.addEventListener('popstate', handlePopState);
+      
+      return {
+        remove: () => {
+          window.removeEventListener('popstate', handlePopState);
+        },
+      };
+    }
+    
+    // For other events, use DeviceEventEmitter
+    const subscription = DeviceEventEmitter.addListener(eventName, handler);
+    return {
+      remove: () => subscription.remove(),
+    };
+  },
+  
+  removeEventListener(_eventName, _handler) {
+    // Handled by subscription.remove() above
+  },
+};
+
+module.exports = BackHandler;
