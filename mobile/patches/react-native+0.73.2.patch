+/**
+ * Web stub for NativeWebSocketModule
+ * Uses browser's native WebSocket API
+ */
+
+'use strict';
+
+const RCTDeviceEventEmitter = require('../EventEmitter/RCTDeviceEventEmitter');
+
+// Map socket IDs to WebSocket instances
+const socketMap = new Map();
+
+// Get the native browser WebSocket that was captured before React Native loaded
+function getNativeWebSocket() {
+  // Only trust the saved native WebSocket captured in web-entry.js
+  if (typeof window !== 'undefined' && window.__NATIVE_WEBSOCKET__) {
+    return window.__NATIVE_WEBSOCKET__;
+  }
+  // If not captured, return null to avoid recursion with RN's WebSocket
+  return null;
+}
+
+const NativeWebSocketModule = {
+  connect(url, protocols, options, socketID) {
+    // On web, disable React Native's WebSocket to avoid recursion with the RN polyfill.
+    // HMR/devtools may not work, but the app will render.
+    const schedule =
+      (typeof setTimeout !== 'undefined' && setTimeout) ||
+      (typeof queueMicrotask !== 'undefined' && queueMicrotask) ||
+      (fn => Promise.resolve().then(fn));
+    schedule(() => {
+      RCTDeviceEventEmitter.emit('websocketFailed', {
+        id: socketID,
+        message: 'WebSocket disabled in web stub',
+      });
+    });
+    return;
+  },
+
+  send(_message, _socketID) {
+    // no-op on web stub
+  },
+
+  sendBinary(_base64String, _socketID) {
+    // no-op on web stub
+  },
+
+  ping(_socketID) {
+    // no-op on web stub
+  },
+
+  close(_code, _reason, socketID) {
+    socketMap.delete(socketID);
+  },
+
+  addListener(eventName) {
+    // Handled by RCTDeviceEventEmitter
+  },
+
+  removeListeners(count) {
+    // Handled by RCTDeviceEventEmitter
+  },
+};
+
+module.exports = NativeWebSocketModule;
