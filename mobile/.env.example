# API Configuration
# Backend API URL - where your backend and OAuth endpoints live
# Option A - Direct to backend (you'll be redirected to this URL for Google login, then back to the app):
#   EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Option B - Same origin (run scripts/dev-proxy.js so app stays on 8081; proxy forwards /api to backend):
#   EXPO_PUBLIC_API_URL=http://localhost:8081/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Stripe Configuration
# Get from Stripe Dashboard: https://dashboard.stripe.com/apikeys
# Use publishable key (starts with pk_test_ or pk_live_)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# OAuth Configuration - Google
# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Use the Client ID (not the secret - that goes in backend)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OAuth Configuration - Facebook
# Get from Facebook Developers: https://developers.facebook.com/apps/
# Use the App ID (not the secret - that goes in backend)
EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
